# ============================================================
# Avatar Service — пример конфигурации.
#   cp .env.example .env
#
# ⚠️  Значения ниже — ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ.
#     Для staging/prod используйте секрет-менеджер (Vault, K8s Secrets).
#
# ⚠️  Секреты (PASSWORD, SECRET_KEY, ACCESS_KEY) — без дефолтов в config.go,
#     с тегом required. Если не заданы — приложение падает при старте
#     с ошибкой "required environment variable ... is not set".
#
# ⚠️  При изменении POSTGRES_USER/PASSWORD/DB или S3_ACCESS_KEY/SECRET_KEY
#     пересоздайте volume, иначе контейнеры стартуют со старыми кредами:
#       docker compose down -v && docker compose up -d
# ============================================================

# -----------------------------------------------------------------

# --- Application -------------------------------------------------

# -----------------------------------------------------------------

# Режим: dev | staging | prod. Влияет на формат логов (zap dev/prod).
APP_ENV=dev

# Таймаут graceful shutdown приложения при SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT=10s

# -----------------------------------------------------------------

# --- HTTP Server -------------------------------------------------

# -----------------------------------------------------------------

# Адрес HTTP-сервера (":8080" — все интерфейсы, порт 8080).
HTTP_ADDRESS=:8080

# Таймауты http.Server.
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=30s

# Таймаут мягкой остановки HTTP-сервера при shutdown.
HTTP_SHUTDOWN_TIMEOUT=5s

# TLS (опционально). Если оба пусты — сервер работает по HTTP.
# В проде задавать для HTTPS.
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key

# -----------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------

# -----------------------------------------------------------------

# DSN собирается в config.Load() из полей ниже через url.UserPassword
# (экранирует @, :, / в пароле). Переменной POSTGRES_DSN больше нет.

# ⚠️ Dev-only: пароль "postgres" — только для локальной разработки.
# В проде — из секрет-менеджера, сложный.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=avatars

# Хост и порт. Для make run — localhost, для docker compose — сервис postgres.
# В .env.example оставляем localhost, compose переопределяет на "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Режим SSL: disable | require | verify-ca | verify-full.
# ⚠️ В проде — require или verify-full, не disable.
POSTGRES_SSLMODE=disable

# Применять миграции при старте. У worker в compose — false.
POSTGRES_MIGRATE_ON_START=true

# Таймаут на применение миграций.
POSTGRES_MIGRATION_TIMEOUT=30s

# Пул соединений (pgxpool). Дефолты из config.go.
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_CONN_MAX_IDLE_TIME=5m

# Подключение и ретраи при старте.
POSTGRES_CONNECT_TIMEOUT=10s
POSTGRES_MAX_RETRIES=5
POSTGRES_RETRY_INTERVAL=3s

# -----------------------------------------------------------------

# --- S3 / MinIO --------------------------------------------------

# -----------------------------------------------------------------

# S3-совместимое хранилище. Endpoint без схемы (http:// не писать).
# Для MinIO локально — localhost:9000, для docker compose — minio:9000.
S3_ENDPOINT=localhost:9000

# ⚠️ Dev-only: те же креды использует docker compose для MINIO_ROOT_USER/PASSWORD.
# В проде — IAM-ключ сервисного пользователя с политикой только на бакет.
# Сменили здесь — пересоздайте volume minio_data (down -v).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Бакет для файлов. Создаётся автоматически при старте (EnsureBucket).
S3_BUCKET=avatars

# Использовать HTTPS до S3. Для MinIO локально — false.
# ⚠️ В проде — true.
S3_USE_SSL=false

# Стиль адресации S3: true — path-style (MinIO, часть Ceph),
# false — virtual-hosted (AWS S3, RU-провайдеры).
# ⚠️ Для MinIO локально — true, иначе DNS avatars.minio не резолвится.
# В проде на AWS — false.
S3_FORCE_PATH_STYLE=true

# Регион S3. Для MinIO не важен, для AWS/RU — обязателен.
S3_REGION=us-east-1

# Таймаут на создание клиента и EnsureBucket при старте.
S3_CONNECT_TIMEOUT=30s

# -----------------------------------------------------------------

# --- RabbitMQ ----------------------------------------------------

# -----------------------------------------------------------------

# AMQP URL собирается в config.Load() из полей ниже через url.UserPassword.
# Переменной RABBITMQ_URL больше нет.

# ⚠️ Dev-only: guest/guest — дефолт RabbitMQ, только для локальной разработки.
# В проде — отдельный пользователь с ограниченными правами.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Хост и порт. Для make run — localhost, для docker compose — rabbitmq.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Виртуальный хост (namespace для очередей). Пустой или без слэша
# нормализуется в "/" + vhost.
RABBITMQ_VHOST=/

# Heartbeat соединения (сек). RabbitMQ шлёт ping каждые N секунд.
RABBITMQ_HEARTBEAT=60s

# Сколько неподтверждённых сообщений consumer держит на канале.
RABBITMQ_PREFETCH=10

# Таймаут на установку соединения.
RABBITMQ_CONNECT_TIMEOUT=30s

# -----------------------------------------------------------------

# --- Worker ------------------------------------------------------

# -----------------------------------------------------------------

# Retry-политика фоновой обработки (ТЗ п. 2.2, exponential backoff).
# Попыток всего: 3. Задержки: 2s → 4s → 8s (initial × multiplier^n).
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_INITIAL_BACKOFF=2s
WORKER_RETRY_MULTIPLIER=2.0


# --- Build (для docker compose build args) -----------------------
# Прокидываются в Dockerfile через ARG, попадают в pkg/buildinfo.
# Если не заданы — Dockerfile использует дефолты (dev/unknown/unknown).
# make docker-up передаёт значения из git describe/rev-parse/date.
# VERSION=dev
# COMMIT=unknown
# BUILD_DATE=unknown

